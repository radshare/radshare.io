{
  "name": "radshare",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun --filter '@radshare/web' check",
    "dev": "bun --filter '@radshare/web' dev",
    "build": "bun --filter '@radshare/web' build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": "1.4.2"
  }
}
