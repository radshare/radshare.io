{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "types": [
      "bun"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@radshare/protocol": [
        "./packages/protocol/src/index.ts"
      ],
      "@radshare/protocol/*": [
        "./packages/protocol/src/*"
      ]
    }
  },
  "include": [
    "apps/server/**/*.ts",
    "packages/**/*.ts",
    "apps/web/src/lib/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "apps/web/.svelte-kit",
    "apps/web/build",
    "apps/web/src/**/*.svelte.ts"
  ]
}
