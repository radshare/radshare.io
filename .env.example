# Server. Copy to .env or export before `bun apps/server/src/index.ts`.
PORT=3000
HOST=127.0.0.1
RADSHARE_DB=radshare.sqlite

# Required in production -- the process refuses to boot without it.
CLERK_SECRET_KEY=
# Needed server-side too, to resolve a Clerk handshake.
CLERK_PUBLISHABLE_KEY=

# Comma-separated origins. Without it Clerk accepts a token minted for any origin.
RADSHARE_AUTHORIZED_PARTIES=

# Local only. Ignored when NODE_ENV=production.
# RADSHARE_DEV_AUTH=1
